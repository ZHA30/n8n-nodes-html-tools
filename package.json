{
	"name": "n8n-nodes-html-tools",
	"version": "0.1.0",
	"description": "Detect content language and translate HTML with bilingual output in n8n",
	"license": "MIT",
	"homepage": "https://github.com/ZHA30/n8n-nodes-html-tools#readme",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "ZHA30",
		"email": "115915443+ZHA30@users.noreply.github.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ZHA30/n8n-nodes-html-tools.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "npm run build && node --test tests/*.test.cjs"
	},
	"files": [
		"dist",
		"NOTICE",
		"LICENSE"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": false,
		"nodes": [
			"dist/nodes/LanguageDetect/LanguageDetect.node.js",
			"dist/nodes/HtmlTranslate/HtmlTranslate.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.57.3",
		"@types/jsdom": "21.1.7",
		"@types/node": "^24.0.0",
		"n8n-workflow": "2.48.0",
		"typescript": "5.9.3",
		"prettier": "3.6.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"engines": {
		"node": ">=24"
	},
	"dependencies": {
		"jsdom": "^26.1.0",
		"tinyld": "^1.3.4"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public"
	}
}
